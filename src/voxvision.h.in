/**
   @file voxvision.h
   @brief Types and declarations for voxvision libraries
**/

#ifndef VOXVISION_H
#define VOXVISION_H

#define VOX_MODULE_PATH "@voxengine_module_path@/"
#define VOX_DATA_PATH "@voxengine_data_path@/"

/**
   \brief Use SSE intrinsics
**/

#define VOX_VERSION_MAJOR @voxvision_VERSION_MAJOR@
#define VOX_VERSION_MINOR @voxvision_VERSION_MINOR@
#define VOX_VERSION "@voxvision_VERSION@"
#define VOX_EXPORT __attribute__((visibility ("default")))

// Types
/*
  Data type layout:
  1) vox_dot

  ----+---+---+------
  |   |   |   |     |
  | x | y | z | XXX |
  |   |   |   |     |
  ----+---+---+------

  0..........96....128

  2) vox_quat

  ----+---+---+----
  |   |   |   |   |
  | i | j | k | 1 |
  |   |   |   |   |
  ----+---+---+----
  0..............128
*/

typedef float vox_dot  __attribute__((ext_vector_type(4)));
typedef float vox_quat __attribute__((ext_vector_type(4)));
#define vox_alloc(size) aligned_alloc (16, size)
#define vox_dot_equalp(d1, d2) ((d1.x == d2.x) && (d1.y == d2.y) && (d1.z == d2.z))

/**
   \brief Structure representing a box.
**/
struct vox_box
{
    vox_dot min; /**< \brief minimal coordinate */
    vox_dot max; /**< \brief maximal coordinate */
};

static inline void
vox_box_copy (struct vox_box *dst, const struct vox_box *src) {
    dst->min = src->min;
    dst->max = src->max;
}

#endif
